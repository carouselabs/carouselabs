# ── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Clerk (auth) ─────────────────────────────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
# Clerk v7 uses these names (v4's NEXT_PUBLIC_CLERK_AFTER_SIGN_IN/UP_URL are ignored)
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# ── Database (Supabase / Postgres) ────────────────────────────────
# DATABASE_URL: Supabase's pooled connection (PgBouncer, transaction mode),
# port 6543 — what the app uses at runtime. pgbouncer=true tells Prisma the
# pooler doesn't support prepared statements; connection_limit=1 keeps each
# serverless/dev-reload instance from opening more than one pooled
# connection (see lib/db.ts's globalThis-cached PrismaClient, which is what
# keeps a single dev process from needing more than one anyway).
DATABASE_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL: the same pooler host on port 5432 (session mode, prepared
# statements supported) — schema.prisma's directUrl, used for
# `prisma migrate`/`db push`, which the transaction pooler above can't run.
DIRECT_URL=postgresql://postgres.xxxxxxxxxxxx:password@aws-0-REGION.pooler.supabase.com:5432/postgres

# ── Upstash Redis ─────────────────────────────────────────────────
REDIS_URL=https://xxxxxx.upstash.io
UPSTASH_REDIS_REST_URL=https://xxxxxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Anthropic (Claude) ────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Optional: how long (ms) the extensions wait for the first AI model's first
# words before switching to the backup model. Default 4000; 1000-15000.
# ENGAGE_FIRST_TEXT_MS=4000

# ── OpenAI (image generation) ────────────────────────────────────
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Cloudflare R2 (image storage) ─────────────────────────────────
CLOUDFLARE_R2_ACCOUNT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_ACCESS_KEY_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLOUDFLARE_R2_BUCKET_NAME=carouselabs
CLOUDFLARE_R2_PUBLIC_URL=https://pub-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.r2.dev

# ── Razorpay (payments) ───────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxx

# ── Resend (email) ────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=noreply@carouselabs.com
# Signing secret for the email.opened/email.clicked/email.bounced webhook
# (see app/api/webhooks/resend) — from the Resend dashboard's Webhooks page
# after adding an endpoint pointed at /api/webhooks/resend.
RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── PostHog (analytics) ───────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ── Admin panel ───────────────────────────────────────────────────
# Only this email can access /admin (server-side check in the admin layout
# and every /api/admin route). Set in Vercel too.
ADMIN_EMAIL=you@example.com

# ── Sentry (error tracking) ───────────────────────────────────────
NEXT_PUBLIC_SENTRY_DSN=https://xxxxxx@oxxxxxx.ingest.sentry.io/xxxxxxx
SENTRY_AUTH_TOKEN=sntrys_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SENTRY_ORG=carouselabs
SENTRY_PROJECT=carouselabs-web

# ── Lemon Squeezy (billing) ────────────────────────────────────────
LEMONSQUEEZY_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
LEMONSQUEEZY_STORE_ID=xxxxxxx
LEMONSQUEEZY_PRODUCT_ID=xxxxxxx
LEMONSQUEEZY_VARIANT_ID=xxxxxxx
LEMONSQUEEZY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_LEMONSQUEEZY_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Growth plan — separate Lemon Squeezy variant, same product/store.
LEMONSQUEEZY_GROWTH_VARIANT_ID=xxxxxxx
NEXT_PUBLIC_LEMONSQUEEZY_GROWTH_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
# Credit top-ups — "Pay What You Want" product, $2 per 100 credits.
LEMONSQUEEZY_TOPUP_VARIANT_ID=xxxxxxx
NEXT_PUBLIC_LEMONSQUEEZY_TOPUP_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx


LEMONSQUEEZY_EXTENSION_VARIANT_ID=xxxxxxx
LEMONSQUEEZY_EXTENSION_CHECKOUT_URL=https://your-store.lemonsqueezy.com/checkout/buy/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Scheduled jobs (Vercel injects this as Authorization: Bearer). Never share URLs containing it.
CRON_SECRET=replace-with-a-long-random-secret
# LinkedIn OAuth: register the exact callback URL in the LinkedIn app.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/linkedin/callback
NEWS_API_KEY=
# Development-only paywall bypass; production always enforces access.
COMMENT_CREDITS_ENFORCED=true
# Optional separate output directory for local audit builds.
# NEXT_BUILD_DIR=.next-audit

# Razorpay, PostHog and Sentry entries above are legacy/reserved examples.
# This audit did not enable these integrations or new external telemetry.
