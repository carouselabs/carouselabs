generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ────────────────────────────────────────────────────────

enum Plan {
  FREE
  PRO
  GROWTH
}

enum IdeaMode {
  TRENDING
  EVERGREEN
  PERSONAL
}

enum IdeaCategory {
  LEADERSHIP
  GROWTH
  PRODUCTIVITY
  STORYTELLING
  INDUSTRY
  PERSONAL_BRAND
  CAREER
  OTHER
}

enum PostFormat {
  CAROUSEL
  SINGLE_IMAGE
  TEXT_ONLY
  THUMBNAIL
  // User's own content uploaded through the Content Hub Custom Post composer
  // — no AI generation step, no credit charge. See
  // app/api/content-hub/custom-post/route.ts.
  CUSTOM
}

enum PostStatus {
  DRAFT
  GENERATING
  READY
  PUBLISHED
  FAILED
}

enum SlideRole {
  COVER
  CONTENT
  CALLOUT
  CTA
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
  EXPIRED
  PAUSED
}

enum HistoryStatus {
  BREAKDOWN
  CAPTION
  CAPTION_DONE
  IMAGE
  IMAGE_DONE
  CAROUSEL
  CAROUSEL_DONE
}

// ── Models ───────────────────────────────────────────────────────

model User {
  id          String    @id @default(cuid())
  clerkId     String    @unique
  email       String    @unique
  deletedAt   DateTime?
  // ── Admin panel ──
  adminNote   String?   @db.Text
  suspendedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  profile        Profile?
  ideas          Idea[]
  posts          Post[]
  subscription   Subscription?
  linkedIn       LinkedInAccount?
  usage          UsageCounter?
  history        IdeaHistory[]
  scheduledPosts ScheduledPost[]
  recurringSlots RecurringSlot[]
  queueSlots     QueueSlot[]
  ideaBoardItems IdeaBoardItem[]
  extensionKeys  ExtensionApiKey[]
  startPage      StartPage?
  postTemplates  PostTemplate[]
  postTags       PostTag[]
  hashtagGroups  HashtagGroup[]
  shortLinks     ShortLink[]

  // ── CarouseLabs Engage extension ──
  defaultCommentProfileId    String?
  defaultConnectionProfileId String?
  defaultMessageProfileId    String?
  insertWarningHidden        Boolean                @default(false)
  // Preferred language for new comment profiles. Nullable rather than
  // defaulted, so "never chosen" stays distinguishable from "chose English".
  defaultLanguage            String?
  commentProfiles            CommentProfile[]
  connectionProfiles         ConnectionProfile[]
  messageProfiles            MessageProfile[]
  commentHistory             CommentHistory[]
  extensionTokens            ExtensionToken[]
  // Free generations used, for life. The first EXT_FREE_GENERATIONS
  // (lib/extensionAccessRules.ts) are free; after that the extension needs
  // an active ExtensionSubscription.
  extensionTrialUsed         Int                    @default(0)
  extensionSubscription      ExtensionSubscription?
  // Extension settings that used to live only in one browser, moved here so
  // the website's Extension section can edit them too. All nullable: null
  // means "never set", which the extension treats as its old local value
  // (uploaded once) or its built-in default.
  //   connectNoteContext  { choice: "profile"|"custom"|"none", purpose }
  //   connectNoteLength   { preset: "short"|"medium"|"custom", min, max }
  //   linkedinProfile     { name, headline, currentRole, about, url, capturedAt }
  //                       — the user's own profile, for "Use my LinkedIn profile"
  connectNoteContext         Json?
  connectNoteLength          Json?
  linkedinProfile            Json?
  insertButtonHidden         Boolean?
  contactContexts            ContactContext[]

  // ── Engage admin (admin.carouselabs.com → Engage) ──
  engageControl EngageUserControl?
  engageGrants  EngageAccessGrant[]
  engageUsage   EngageUsageCounter[]
  engageClients EngageClientInfo[]
  engageErrors  EngageClientError[]
  adminNotes    AdminNote[]
  adminTags     AdminUserTag[]
  // CarouseLabs Engage for X (scripts/x-extension-schema.sql)
  xProfiles     XProfile[]
  xSettings     XUserSettings?

  // ── Referral program ──
  referralCode       String?              @unique
  referralsMade      Referral[]           @relation("ReferralsMade")
  referredByRelation Referral?            @relation("ReferredBy")
  commissions        ReferralCommission[]
  payouts            ReferralPayout[]
  // Where to actually send a referrer's payout — self-reported via
  // Settings > Referrals (see app/api/referrals/me PATCH), admin-readable
  // only (see components/admin/ReferralsTable.tsx). Free text rather than
  // structured bank fields on purpose: this is read by a human arranging a
  // manual transfer, not consumed by any payment API.
  payoutMethod       String? // "bank" | "paypal"
  payoutDetails      String?              @db.Text

  // ── Email marketing ──
  sequenceEnrollments EmailSequenceEnrollment[]
  emailEngagement     EmailEngagement[]

  @@index([clerkId])
}

model Profile {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  name                      String?
  headline                  String?
  industry                  String?
  targetAudience            String?
  contentPillars            String[]
  writingStyle              String?
  voiceGuidelines           String?   @db.Text
  voicePresets              Json?
  linkedInUrl               String?
  timezone                  String    @default("UTC")
  onboardingDone            Boolean   @default(false)
  // Set when this Profile was written by an admin via /admin/prefill-user
  // (either applied directly, or carried over from a PendingProfilePrefill
  // at signup) rather than filled in by the user themselves through
  // onboarding. Drives the "please review your profile" dashboard banner.
  prefilledByAdmin          Boolean   @default(false)
  // Cleared (see app/api/profile PATCH) once the user dismisses that banner
  // or actually edits their profile in Settings — whichever comes first.
  profileReviewDismissed    Boolean   @default(false)
  // Last time the weekly "check out your referral program" dashboard banner
  // was shown to this user — see app/api/referrals/reminder. Stamped the
  // moment that route decides to show it (not on a separate dismiss call),
  // so it's set exactly once per calendar week regardless of whether the
  // user interacts with the banner at all.
  lastReferralReminderShown DateTime?
  // Cached AI "what to post about" suggestions for the generate bar.
  // Regenerated only when ideaSuggestionsKey (a hash of profile inputs) changes.
  ideaSuggestions           String[]  @default([])
  ideaSuggestionsKey        String?
  // Email notification preferences (Settings > Account). Default true so
  // existing users keep getting exactly the emails they already got before
  // these toggles existed — this is an opt-OUT, not an opt-in.
  // notifyWeeklySummary is stored and settable now, but nothing sends that
  // email yet — see app/api/cron/publish-scheduled-posts/route.ts's comment.
  notifyPostPublished       Boolean   @default(true)
  notifyPostFailed          Boolean   @default(true)
  notifyWeeklySummary       Boolean   @default(true)
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// An onboarding profile an admin pre-filled for someone by email BEFORE they
// signed up (see app/api/admin/prefill-user). Keyed by email rather than a
// User relation because no User row exists yet — mirrors how Intern.clerkId
// starts null and gets linked on first login, except here linking happens by
// consuming (and deleting) this row into a real Profile the moment a User
// with a matching email is created (see lib/profile/pendingPrefill.ts),
// rather than by filling in a nullable FK.
model PendingProfilePrefill {
  id             String   @id @default(cuid())
  email          String   @unique
  headline       String?
  industry       String?
  targetAudience String?
  contentPillars String[]
  writingStyle   String?
  createdBy      String // admin's email, for audit
  createdAt      DateTime @default(now())
}

model Idea {
  id          String       @id @default(cuid())
  userId      String
  title       String
  hook        String
  mode        IdeaMode
  category    IdeaCategory
  source      String?      @default("trending")
  isPinned    Boolean      @default(false)
  isDismissed Boolean      @default(false)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  breakdowns Breakdown[]
  posts      Post[]
  history    IdeaHistory[]

  @@index([userId])
  @@index([userId, isPinned])
}

model Breakdown {
  id        String   @id @default(cuid())
  ideaId    String
  userId    String
  outline   Json
  createdAt DateTime @default(now())

  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@index([ideaId])
  @@index([userId])
}

model Post {
  id          String     @id @default(cuid())
  userId      String
  ideaId      String?
  title       String
  caption     String?
  format      PostFormat
  status      PostStatus @default(DRAFT)
  imageUrls   String[]
  r2Keys      String[]
  metadata    Json?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  publishedAt DateTime?

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea           Idea?           @relation(fields: [ideaId], references: [id], onDelete: SetNull)
  slides         Slide[]
  scheduledPosts ScheduledPost[]
  tags           PostTag[]

  @@index([userId])
  @@index([userId, status])
  @@index([userId, createdAt])
}

// Content Hub — a single generated Post scheduled to publish on one platform
// at a given time. A Post can have more than one ScheduledPost (e.g. the same
// carousel scheduled to both LinkedIn and Instagram, or resubmitted after
// editing the time), so this is deliberately its own table rather than fields
// bolted onto Post.
model ScheduledPost {
  id              String   @id @default(cuid())
  userId          String
  postId          String
  platform        String // see lib/platforms.ts's Platform union — a plain string so a new platform never needs a migration
  scheduledFor    DateTime // stored UTC; the client renders it in local time
  // "draft" | "queued" | "publishing" | "published" | "failed" | "cancelled" |
  // "pending_connection" (queued for a platform with no real posting access
  // yet — see lib/platforms.ts's `functional` flag; the cron publisher only
  // ever queries status "queued", so these rows are never touched until that
  // platform's `functional` flag flips true and existing rows are requeued)
  status          String   @default("queued")
  publishedUrl    String?
  failureReason   String?
  retryCount      Int      @default(0)
  // Set when created by the cron worker filling a RecurringSlot; null for a
  // one-off scheduled post. No FK — the rule can be edited/deleted without
  // touching posts it already generated.
  recurringRuleId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, scheduledFor])
  @@index([status, scheduledFor])
  @@index([postId])
}

// Content Hub — "post automatically every [days] at [time] on [platform]".
// The cron worker reads active slots and creates a queued ScheduledPost from
// the user's most recent unscheduled content when a slot's time arrives.
model RecurringSlot {
  id         String   @id @default(cuid())
  userId     String
  label      String
  daysOfWeek Int[] // 0=Sunday..6=Saturday
  timeOfDay  String // "HH:mm", local to the user's profile timezone
  platform   String // see lib/platforms.ts's Platform union
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Buffer-style posting queue — a DIFFERENT concept from RecurringSlot even
// though the shape looks similar, so it's a separate model rather than
// reusing/extending RecurringSlot (see lib/queue.ts for the full comparison
// this comment summarizes):
//   - RecurringSlot is fully automatic: the cron worker itself PICKS the
//     content (the user's most recent unscheduled post) when a slot's time
//     arrives — the user never explicitly creates a post for it.
//   - QueueSlot is just a smarter default time picker: the user explicitly
//     creates/composes a post and chooses "Add to Queue", and the app
//     assigns it to the next empty slot occurrence. One ScheduledPost is
//     created immediately with a computed `scheduledFor` — after that it's
//     indistinguishable from a manually-scheduled post to the rest of the
//     system (same cron, same drafts/calendar/history).
//   - The data shape also differs in a way that would need a migration to
//     unify: RecurringSlot stores multiple days per row (`daysOfWeek Int[]`,
//     e.g. Mon+Wed+Fri in one row); QueueSlot stores one day per row by
//     design, since "find the next empty occurrence" is naturally a
//     per-(day,time) lookup, not a per-multi-day-rule one.
model QueueSlot {
  id        String   @id @default(cuid())
  userId    String
  dayOfWeek Int // 0=Sunday..6=Saturday
  timeOfDay String // "HH:mm", local to the user's profile timezone
  platform  String // see lib/platforms.ts's Platform union
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Content Library / Ideas Board — a lightweight scratchpad for raw material
// (a link, an image, or a quick note) saved for later, either from inside the
// app or captured from any webpage via browser-extension-ideas/. "Turn into
// Post" (Content Hub > Ideas) pre-fills the Custom Post composer with an
// item's content — this never touches AI generation or credits, same as a
// Custom Post itself.
model IdeaBoardItem {
  id        String   @id @default(cuid())
  userId    String
  type      String // "link" | "image" | "note"
  content   String   @db.Text // URL, image URL, or note text
  sourceUrl String? // the page it was captured from, if applicable
  title     String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, createdAt])
}

// Long-lived credential for browser-extension-ideas/ (and any future
// extension) to call app/api/ideas-board/capture on the user's behalf. An
// extension has no Clerk session cookie to authenticate with, so it needs its
// own bearer credential instead — this did not exist anywhere in the
// codebase before Phase C; there was no earlier "LinkedIn AI extension" work
// to reuse a pattern from, so this is a new, minimal design (see
// lib/extensionAuth.ts): only `keyHash` (SHA-256 of the actual key) is ever
// stored, never the plaintext key itself, which is shown to the user exactly
// once at generation time (app/api/settings/extension-key).
model ExtensionApiKey {
  id         String    @id @default(cuid())
  userId     String    @unique // one active key per user for now — regenerating replaces it
  keyHash    String    @unique
  label      String    @default("Browser extension")
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// ── CarouseLabs Engage extension ───────────────────────────────────
// A reusable "voice" for AI-generated LinkedIn comments (who the commenter
// is, their goal, tone, length, etc.). userId is nullable because isSystem
// profiles are built-in presets shared by everyone (not owned by any one
// user); a user's own custom profiles always have userId set.
// Connection request notes (app/api/ext/connection-note). Same shape as
// CommentProfile, minus the fields a 280-character invitation has no use for
// (emoji, language): a note is short, plain and sent under the user's name.
// Separate table rather than a "kind" column on CommentProfile, so no existing
// comment query can accidentally pick up a connection profile.
model ConnectionProfile {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  // How the sender should come across: the note's angle, not the sender's bio
  // (that comes from the "Your context" setting).
  angle         String
  goal          String
  tone          String
  length        String
  alwaysDo      String?
  neverDo       String?
  samples       String[]
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false)
  isRecommended Boolean  @default(false)
  testsUsed     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// Conversation Assistant (app/api/ext/message). What an ongoing reply/opener
// is FOR — no length field, unlike CommentProfile/ConnectionProfile: a
// message thread isn't bound to a single-comment or a 280-character invite,
// so length is left to the model's judgement (short opener, longer reply,
// whatever the moment calls for) rather than a range the user sets once.
// The browser extension's own $15/month Lemon Squeezy subscription. Separate
// from Subscription (the web app's Free/Pro/Growth plan) on purpose: one user
// can have both, and neither may change the other. Written only by
// lib/extensionBilling.ts from Lemon Squeezy webhooks.
model ExtensionSubscription {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  lsSubscriptionId  String    @unique
  lsCustomerId      String?
  lsVariantId       String?
  // Lemon Squeezy's status, verbatim: on_trial, active, paused, past_due,
  // unpaid, cancelled, expired.
  status            String
  renewsAt          DateTime?
  // Set once cancelled: access continues until this moment.
  endsAt            DateTime?
  customerPortalUrl String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model MessageProfile {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  // The relationship's purpose: why this conversation is happening, in the
  // sender's own words — "warm intro", "qualifying a lead", "just building
  // my network". Read alongside the live thread on every generation, so it
  // stays the throughline across replies sent weeks apart.
  goal          String
  tone          String
  alwaysDo      String?
  neverDo       String?
  samples       String[]
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false)
  isRecommended Boolean  @default(false)
  testsUsed     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

model CommentProfile {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  whoIAm        String
  goal          String
  tone          String
  length        String
  emoji         String   @default("None")
  language      String   @default("English")
  alwaysDo      String?
  neverDo       String?
  samples       String[]
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false)
  // Curated CarouseLabs presets, surfaced first and badged in the extension.
  // Always also isSystem: a recommended profile is a kind of system profile.
  isRecommended Boolean  @default(false)
  testsUsed     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// CarouseLabs Engage for X: voice profiles for X replies, kept apart from the
// LinkedIn extension's CommentProfile (the user chose separate lists) but with
// the same fields, so the same builder, validation and prompt parts serve
// both. userId null + isSystem = a CarouseLabs preset everyone sees.
// New table only (scripts/x-extension-schema.sql): nothing LinkedIn reads
// changes.
model XProfile {
  id            String   @id @default(cuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  name          String
  whoIAm        String
  goal          String
  tone          String
  length        String
  emoji         String   @default("None")
  language      String   @default("English")
  alwaysDo      String?
  neverDo       String?
  samples       String[]
  isDefault     Boolean  @default(false)
  isSystem      Boolean  @default(false)
  isRecommended Boolean  @default(false)
  testsUsed     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

// The X extension's per-account settings, in their own table so the X
// extension adds no column to User. No row = the defaults.
model XUserSettings {
  userId             String   @id
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  // null = the shared default preset (XProfile.isDefault).
  defaultProfileId   String?
  // X Premium accounts can post longer than 280; replies are written to fit.
  maxReplyLength     Int      @default(280)
  insertButtonHidden Boolean  @default(false)
  updatedAt          DateTime @default(now()) @updatedAt
}

// One row per AI generation in the LinkedIn extension — comments, replies,
// connection notes and messages (`kind`) — driving the History screen in the
// side panel and on the website (app/(app)/extension/history). profileId is
// a plain string, not a relation — deliberately no FK, so a history row
// survives even if the profile it was generated with is later edited or
// deleted. It points at a CommentProfile for comments/replies, a
// ConnectionProfile or MessageProfile for notes/messages, and is null when a
// note or message used a one-off reason instead of a saved profile.
// profileName is the name at generation time, so the row still reads right
// after a rename or delete.
model CommentHistory {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind        String   @default("comment") // "comment" | "reply" | "connection_note" | "message"
  profileId   String?
  profileName String?
  postAuthor  String
  postUrl     String
  postSnippet String
  comment     String   @db.Text
  action      String   @default("NONE") // "COPIED" | "INSERTED" | "NONE"
  creditsUsed Float
  model       String
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([profileId])
  @@index([userId, createdAt])
  @@index([userId, kind, createdAt])
}

// The Conversation Assistant's per-person memory: which reason and tone a
// conversation with one contact uses, so reopening that chat picks up where
// it left off. One row per (user, contact). contactUrl is the contact's
// LinkedIn profile path as the extension reads it ("/in/…", lowercase).
// profileId points at a MessageProfile when choice is "profile"; a plain
// string, like CommentHistory.profileId, so deleting the profile leaves the
// row readable.
model ContactContext {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contactUrl  String
  contactName String   @default("")
  choice      String // "profile" | "custom" | "flow"
  profileId   String?
  purpose     String   @default("")
  tone        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, contactUrl])
  @@index([userId, updatedAt])
}

// Long-lived credential for browser-extension-comment/ to call app/api/ext/*
// on the user's behalf — same bearer-token design as ExtensionApiKey (see its
// comment above): only tokenHash (SHA-256 of the actual token) is ever
// stored, the plaintext token is returned exactly once from
// app/api/ext/auth/exchange and never persisted. A separate model (not a
// reuse of ExtensionApiKey) because this one supports multiple concurrent
// tokens per user (one per device/browser install, see `device`) and
// revocation of a single token without affecting others, neither of which
// ExtensionApiKey's one-key-per-user design supports.
model ExtensionToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  device     String?
  lastUsedAt DateTime  @default(now())
  revokedAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

// Start Page — a simple link-in-bio page at carouselabs.com/start/[slug].
// One per user (userId is @unique). Publicly readable by anyone who knows
// the slug (see app/(marketing)/start/[slug]/page.tsx and proxy.ts's public
// route list) — only the owner can edit it (app/(app)/settings/start-page).
model StartPage {
  id        String   @id @default(cuid())
  userId    String   @unique
  slug      String   @unique
  title     String?
  bio       String?  @db.Text
  avatarUrl String?
  theme     String   @default("default") // see components/startpage — a small fixed set of presets
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  links StartPageLink[]

  @@index([slug])
}

model StartPageLink {
  id          String   @id @default(cuid())
  startPageId String
  label       String
  url         String
  order       Int
  clickCount  Int      @default(0)
  createdAt   DateTime @default(now())

  startPage StartPage @relation(fields: [startPageId], references: [id], onDelete: Cascade)

  @@index([startPageId])
  @@index([startPageId, order])
}

// Content Hub Library — a saved caption a user reuses across posts. Loading
// one into the Custom Post composer just fills the caption textarea; nothing
// AI-generated, no credit charge.
model PostTemplate {
  id        String   @id @default(cuid())
  userId    String
  name      String
  caption   String   @db.Text
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Content Hub Library — a label a user can attach to any Post (implicit
// many-to-many via Post.tags) to filter/group the calendar and list views
// later. Scoped to the Custom Post composer for now (see
// app/api/content-hub/custom-post/route.ts and .../scheduled/route.ts).
model PostTag {
  id     String @id @default(cuid())
  userId String
  name   String
  color  String @default("#7C3AED")

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts Post[]

  @@index([userId])
}

// Content Hub Library — a saved set of hashtags a user can quick-insert into
// a caption instead of retyping the same group every time.
model HashtagGroup {
  id       String   @id @default(cuid())
  userId   String
  name     String
  hashtags String[]

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Content Hub Library — a short carouselabs.com/l/[slug] link that redirects
// to targetUrl and counts clicks (see app/l/[slug]/route.ts, public — added
// to proxy.ts). Any UTM params the user added at creation time are already
// baked into targetUrl itself (see lib/utm.ts), not stored separately.
model ShortLink {
  id         String   @id @default(cuid())
  userId     String
  slug       String   @unique
  targetUrl  String
  clickCount Int      @default(0)
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Slide {
  id        String    @id @default(cuid())
  postId    String
  role      SlideRole
  order     Int
  headline  String?
  body      String?
  imageUrl  String?
  r2Key     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([postId, order])
}

model IdeaHistory {
  id            String        @id @default(cuid())
  userId        String
  ideaId        String
  status        HistoryStatus @default(BREAKDOWN)
  isPinned      Boolean       @default(false)
  lastVisitedAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  idea Idea @relation(fields: [ideaId], references: [id], onDelete: Cascade)

  @@unique([userId, ideaId])
  @@index([userId])
  @@index([userId, isPinned])
  @@index([userId, lastVisitedAt])
}

model Subscription {
  id                 String             @id @default(cuid())
  userId             String             @unique
  plan               Plan               @default(FREE)
  status             SubscriptionStatus @default(ACTIVE)
  razorpaySubId      String?
  razorpayCustomerId String?
  lsSubscriptionId   String?
  lsCustomerId       String?
  lsVariantId        String?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  // Pro → Growth upgrade scheduled to take effect at next renewal (no charge
  // or credit change until then).
  upgradeScheduled   Boolean            @default(false)
  // ── Credits ──
  creditsUsed        Int                @default(0)
  creditsTotal       Int                @default(1000)
  extraCredits       Int                @default(0)
  extraCreditsExpiry DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([razorpaySubId])
  @@index([lsSubscriptionId])
}

model LinkedInAccount {
  id           String    @id @default(cuid())
  userId       String    @unique
  linkedInId   String    @unique
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  name         String?
  pictureUrl   String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model UsageCounter {
  id          String   @id @default(cuid())
  userId      String   @unique
  postsToday  Int      @default(0)
  postsTotal  Int      @default(0)
  lastResetAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// App-level settings editable from the admin panel (plan price, feature
// flags, maintenance mode). One row per key, Json value.
model AppSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

// Immutable record of every mutating admin-panel action (credits, plan,
// suspend, notes, settings, broadcasts) — who did what, to whom, when.
model AuditLog {
  id           String   @id @default(cuid())
  adminEmail   String
  action       String
  targetUserId String?
  targetEmail  String?
  details      String   @db.Text
  ipAddress    String?
  createdAt    DateTime @default(now())
  // Structured detail, set by newer actions (Engage admin). Older rows have
  // only `details`. product: "engage" | null (the web app).
  product      String?
  oldValue     Json?
  newValue     Json?
  reason       String?  @db.Text

  @@index([action])
  @@index([targetEmail])
  @@index([createdAt])
  @@index([targetUserId, createdAt])
  @@index([product, createdAt])
}

// ── Engage admin ─────────────────────────────────────────────────────
// What an admin has set for one user's Engage access, on top of the plan
// (10 free generations for life, then the $15/month subscription). One row
// per user, created on the first admin change; no row means "all plan
// defaults". lib/engage/access.ts turns this into effective access.
//   features { comments?, replies?, connection_notes?, messages? }: "on" | "off"
//            (absent = plan default, which is on)
//   limits   { dailyCap?: number | "unlimited",
//              "<feature>.day"? / "<feature>.month"?: number | "unlimited" }
//            (absent = plan default)
model EngageUserControl {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  features        Json      @default("{}")
  limits          Json      @default("{}")
  // Overrides the 10 free generations for this user when set.
  freeGenerations Int?
  // Engage-only suspension: blocks every Engage generation, leaves the rest
  // of the account (website, billing) alone. User.suspendedAt still blocks
  // everything.
  suspendedAt     DateTime?
  suspendedBy     String?
  suspendReason   String?   @db.Text
  updatedAt       DateTime  @updatedAt
  updatedBy       String?
}

// Unlimited Engage access given by an admin, outside Lemon Squeezy. endsAt
// null = lifetime. A grant can name someone who hasn't signed up yet: email
// is always set, userId once the account exists (matched by email until then).
model EngageAccessGrant {
  id           String    @id @default(cuid())
  userId       String?
  user         User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  email        String
  startsAt     DateTime  @default(now())
  endsAt       DateTime?
  reason       String    @db.Text
  grantedBy    String
  createdAt    DateTime  @default(now())
  revokedAt    DateTime?
  revokedBy    String?
  revokeReason String?   @db.Text

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

// Generations per user, feature and calendar period (UTC), counted at the
// moment a generation is allowed. Drives per-user limits and the admin's
// usage figures. feature: "comments" | "replies" | "connection_notes" |
// "messages" | "rewrites" | "tests"; period: "day" | "month".
model EngageUsageCounter {
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature     String
  period      String
  periodStart DateTime @db.Date
  count       Int      @default(0)
  updatedAt   DateTime @updatedAt

  @@id([userId, feature, period, periodStart])
  @@index([period, periodStart])
}

// The extension version each signed-in browser last reported (one row per
// ExtensionToken). Kept out of ExtensionToken itself so token checks never
// depend on this table.
model EngageClientInfo {
  tokenId          String   @id
  userId           String
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  extensionVersion String
  lastSeenAt       DateTime @default(now())

  @@index([userId])
  @@index([extensionVersion])
}

// Errors the side panel reports (an Insert that couldn't find LinkedIn's
// box, a conversation that couldn't be read). Metadata only: never the
// post, comment or message text.
model EngageClientError {
  id               String   @id @default(cuid())
  userId           String?
  user             User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature          String
  code             String
  message          String
  extensionVersion String?
  createdAt        DateTime @default(now())

  @@index([createdAt])
  @@index([feature, createdAt])
  @@index([code])
}

// Engage settings that apply to everyone (admin → Engage → Controls), one
// JSON value per key: "features" (a feature paused for all, with the message
// people see), "insert" (Insert on or off per extension) and "minVersion"
// (the oldest extension version still allowed to write, per extension). No
// row means the default: everything on, no minimum. lib/engage/settings.ts.
model EngageSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @default(now()) @updatedAt
  updatedBy String?
}

// One AI model call made for the extensions (lib/ai/commentModel.ts): who,
// for what, which model, the tokens it used, how long it took and how it
// ended. A generation that fell back to the backup model has two rows. Cost
// is worked out when shown, from the prices in admin → Engage → AI. Nothing
// the user wrote or the model answered is stored here.
model EngageAiCall {
  id           String   @id @default(cuid())
  userId       String?
  // The usage kind ("comments", "x_rewrites", …) and its feature.
  kind         String
  feature      String
  route        String
  model        String
  // This call was the backup, after the first model failed or refused.
  fallback     Boolean  @default(false)
  streamed     Boolean  @default(false)
  // ok | refused | empty | error | timeout | cancelled
  outcome      String
  inputTokens  Int?
  outputTokens Int?
  firstTokenMs Int?
  ms           Int
  createdAt    DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([feature, createdAt])
}

// Internal notes on a user. Never shown to the user.
model AdminNote {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  authorEmail String
  body        String   @db.Text
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// Internal labels on a user ("VIP", "Beta tester"). Never shown to the user.
model AdminUserTag {
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tag       String
  createdBy String
  createdAt DateTime @default(now())

  @@id([userId, tag])
  @@index([tag])
}

// Tracks webhook deliveries we've already handled so a provider redelivery
// (retry after a timeout/non-2xx) can't be processed twice — preventing
// duplicate emails and double credit grants/resets.
model ProcessedWebhookEvent {
  id          String   @id @default(cuid())
  eventId     String   @unique
  source      String // "lemonsqueezy", "razorpay", etc. — for future use
  processedAt DateTime @default(now())

  @@index([source])
}

// ── Intern Points Board ─────────────────────────────────────────

// Fixed-point daily tasks offered in the "Quick Task" add-entry mode. Never
// renamed once created (only points/active are editable) so historical
// InternPointEntry.category values stay reliably matched to a task by name.
model PredefinedTask {
  id        String   @id @default(cuid())
  name      String   @unique
  points    Int
  active    Boolean  @default(true)
  role      String? // null = applies to ALL roles, or a specific role string (matching Intern.role)
  createdAt DateTime @default(now())
}

model Intern {
  id             String    @id @default(cuid())
  name           String
  email          String    @unique
  phone          String?
  clerkId        String?   @unique
  role           String? // e.g. "Marketing Intern", "Content Intern"
  department     String?
  photoUrl       String?
  status         String    @default("active") // "active" | "completed" | "terminated" | "extended"
  active         Boolean   @default(true)
  joinDate       DateTime  @default(now())
  durationMonths Int       @default(3) // original planned duration at creation — NOT bumped by extensions (see InternExtension); the true current length is joinDate..endDate
  endDate        DateTime? // calculated on create; on extend, moved forward by the extension's addedDays
  leaveAllowance Int       @default(5)
  createdAt      DateTime  @default(now())

  entries       InternPointEntry[]
  attendance    InternAttendance[]
  leaveRequests InternLeaveRequest[]
  notes         InternNote[]
  extensions    InternExtension[]
  certificates  InternCertificate[]
  messages      InternMessage[]
}

// Freeform notes/reviews an admin attaches to an intern's record — praise,
// warnings, general remarks, or formal review writeups. Feeds the "Notes"
// tab and "review"-type notes surface prominently on the Performance Report.
model InternNote {
  id        String   @id @default(cuid())
  internId  String
  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  content   String   @db.Text
  type      String   @default("general") // "general" | "praise" | "warning" | "review"
  addedBy   String // admin email
  createdAt DateTime @default(now())

  @@index([internId])
}

// Audit trail of internship-length adjustments — each row captures the
// before/after endDate so the profile can show a full history alongside the
// current duration. Stored in days regardless of how the adjustment was
// entered (a day count typed directly, or a month preset converted at
// creation time — 1 month = 30 days) so adjustments of any granularity share
// one consistent, precise unit. Signed: positive extends, negative reduces.
model InternExtension {
  id              String   @id @default(cuid())
  internId        String
  intern          Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  addedDays       Int // signed — positive = extension, negative = reduction
  reason          String?
  previousEndDate DateTime
  newEndDate      DateTime
  extendedBy      String // admin email
  createdAt       DateTime @default(now())

  @@index([internId])
}

model InternPointEntry {
  id        String   @id @default(cuid())
  internId  String
  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  date      DateTime @default(now())
  points    Int
  category  String // "Task Completed" | "SEO Page" | "Bug Fixed" | "Research" | "Late/Missed" | "Custom"
  note      String?
  source    String   @default("manual") // "manual" | "automated"
  addedBy   String // admin email
  createdAt DateTime @default(now())

  @@index([internId])
  @@index([internId, date])
}

// One row per (intern, day) — the day's attendance status. Rows created via
// the admin Daily Checklist (markedBy: admin email) or auto-created by a
// self-service leave application (markedBy: "self").
model InternAttendance {
  id               String    @id @default(cuid())
  internId         String
  intern           Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)
  date             DateTime
  status           String // "present" | "absent" | "half-day" | "leave"
  note             String?
  markedBy         String // admin email OR "self" if intern-marked leave
  // Set the first time the daily notification email (summary or absent
  // warning) is sent for this (intern, day) — re-submitting/editing the same
  // day's checklist afterward must not re-send it. Null = not sent yet.
  dailyEmailSentAt DateTime?
  createdAt        DateTime  @default(now())

  @@unique([internId, date])
  @@index([internId])
}

// Self-service leave applications. Auto-approved on creation (see
// lib/internPoints.ts getLeaveBalance) — "pending"/"rejected" are reserved
// for a future approval workflow but not used by the current self-service
// flow. Revoking (admin) deletes both this row and its matching
// InternAttendance row together.
model InternLeaveRequest {
  id          String    @id @default(cuid())
  internId    String
  intern      Intern    @relation(fields: [internId], references: [id], onDelete: Cascade)
  date        DateTime
  reason      String?
  status      String    @default("approved") // "pending" | "approved" | "rejected"
  requestedAt DateTime  @default(now())
  reviewedBy  String?
  reviewedAt  DateTime?

  @@unique([internId, date])
  @@index([internId])
}

// A certificate an admin has issued to an intern, uploaded to R2. The
// verificationCode is the only thing printed on the certificate itself and
// the only thing the public /verify-certificate page ever looks up by —
// it's deliberately independent of the intern's id so the certificate file
// can be freely shared without exposing any internal identifier.
model InternCertificate {
  id               String   @id @default(cuid())
  internId         String
  intern           Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  verificationCode String   @unique // e.g. "CL-2026-A7X9"
  certificateUrl   String // uploaded file (PDF or image), stored in R2
  issuedFor        String // e.g. "Marketing Internship Completion" - admin enters this
  issuedDate       DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([internId])
}

// Two-way Support thread between an intern and admin. `read` is a single
// shared flag interpreted relative to the OTHER party: an "intern" row is
// unread until admin reads it (marked via the admin messages PATCH), an
// "admin" row is unread until the intern reads it (marked via the intern
// messages PATCH) — see the two /api/.../messages routes.
model InternMessage {
  id        String   @id @default(cuid())
  internId  String
  intern    Intern   @relation(fields: [internId], references: [id], onDelete: Cascade)
  sender    String // "intern" | "admin"
  message   String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([internId])
}

// Shared "send later" queue for both broadcast features (Intern Broadcast
// and the regular-user Broadcast), consumed by
// app/api/cron/publish-scheduled-emails using the same claim/reclaim
// pattern as ScheduledPost (see app/api/cron/publish-scheduled-posts).
//
// recipientType / recipientIds meaning depends on `type`:
//   intern_broadcast: recipientType "all" | "specific"; recipientIds holds
//     Intern cuids when "specific" (matches app/api/admin/interns/broadcast).
//   user_broadcast: recipientType "all" | "pro" | "growth" | "free" |
//     "custom"; recipientIds holds raw, validated email addresses when
//     "custom" (matches lib/broadcast.ts's BroadcastRecipients — there's no
//     per-user ID concept in the existing custom-list flow, so the same
//     field carries emails for this type instead of IDs).
// Non-"specific"/"custom" rows re-resolve their audience fresh at send time
// (e.g. "all active interns" or "all Pro users" may have changed by then).
model ScheduledEmail {
  id             String   @id @default(cuid())
  type           String // "intern_broadcast" | "user_broadcast"
  subject        String
  body           String   @db.Text
  recipientType  String
  recipientIds   String[]
  // Threshold for the extended segments ("inactive" days, "low_credits"
  // amount — see lib/segments.ts) — not in the original field list, added
  // so a scheduled broadcast can use them exactly like an instant one
  // rather than only supporting them for immediate sends.
  recipientValue String?
  scheduledFor   DateTime
  status         String   @default("queued") // "queued" | "sending" | "sent" | "failed"
  sentCount      Int?
  failedCount    Int?
  createdBy      String // admin email
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt // drives the cron's stuck-"sending" reclaim, same role as ScheduledPost.updatedAt

  @@index([status, scheduledFor])
}

// ── Referral program ──────────────────────────────────────────────
// One row per successfully-attributed signup — created once in the Clerk
// user.created webhook (see lib/referral.ts + app/api/webhooks/clerk) after
// its fraud guards pass. @@unique on referredUserId is the hard backstop
// against a person ever having two referrers, enforced at the DB level (not
// just in application code) even if the webhook were ever called twice.
model Referral {
  id               String   @id @default(cuid())
  referrerId       String
  referrer         User     @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredUserId   String   @unique
  referredUser     User     @relation("ReferredBy", fields: [referredUserId], references: [id])
  freeBonusGranted Boolean  @default(false)
  createdAt        DateTime @default(now())

  @@index([referrerId])
}

// One row per commission-worthy payment event on a referred user's
// subscription (see subscription_payment_success in
// app/api/webhooks/lemonsqueezy). sourceOrderId is @unique specifically so a
// Lemon Squeezy webhook redelivery for the same invoice can't double-pay the
// referrer — the duplicate insert fails cleanly (see lib/referral.ts's
// createCommissionForPayment, which catches exactly that P2002 case).
model ReferralCommission {
  id             String    @id @default(cuid())
  referrerId     String
  referrer       User      @relation(fields: [referrerId], references: [id])
  referredUserId String
  sourceOrderId  String    @unique // the Lemon Squeezy order/subscription invoice ID — prevents duplicate commission creation for the same payment event
  amount         Float
  sourceEvent    String
  status         String    @default("pending") // "pending" | "paid" | "reversed"
  createdAt      DateTime  @default(now())
  paidAt         DateTime?
  paidBy         String?
  reversedAt     DateTime? // set if the underlying payment was later refunded
  reversedReason String?

  @@index([referrerId, status])
}

// One row per admin-recorded manual payout to a referrer (there's no
// automated payout rail yet — see the admin dashboard's "Record Payout").
// Recording a payout also flips every currently-"pending" commission for
// that referrer to "paid" in the same transaction (see
// app/api/admin/referrals/[userId]/route.ts) — this table itself is just the
// payment record, not a ledger of which commissions it covered.
model ReferralPayout {
  id         String   @id @default(cuid())
  referrerId String
  referrer   User     @relation(fields: [referrerId], references: [id])
  amount     Float
  method     String?
  paidBy     String
  createdAt  DateTime @default(now())
}

// A reusable subject+body pair an admin can load into either the one-off
// Broadcast composer or a Sequence step's editor (see
// components/admin/TemplatePicker.tsx), instead of retyping common copy.
// Deliberately just two text fields, no category/tagging system — the
// admin panel doesn't have enough of these yet to need one.
model EmailTemplate {
  id        String   @id @default(cuid())
  name      String
  subject   String
  body      String   @db.Text
  createdBy String
  createdAt DateTime @default(now())
}

// ── Email marketing: sequences ──────────────────────────────────────
// Multi-step drip campaigns, auto-enrolling users who match segmentType/
// segmentValue (the same recipient-segment vocabulary as the one-off
// Broadcast composer — see lib/broadcast.ts — plus the extended segments
// added for this feature). Distinct from the existing one-off Broadcast +
// ScheduledEmail system, which is unchanged and still the right tool for a
// single announcement; sequences are for automated, multi-touch drips.
model EmailSequence {
  id           String   @id @default(cuid())
  name         String
  active       Boolean  @default(true)
  segmentType  String // reuses existing recipient segment types (see lib/segments.ts)
  segmentValue String?
  // Exit condition checked before sending each step (see the cron in
  // app/api/cron/process-email-sequences) — null means no auto-exit. Not in
  // the original field list; added because Step 4/5 of the spec both
  // require somewhere to store which rule a sequence uses. Only "upgraded"
  // is wired to a real signal today — there's no support-ticket system for
  // regular users (InternMessage is intern-only) to check a "replied to
  // Support" condition against.
  stopRule     String? // null | "upgraded" (exits when Subscription.plan leaves FREE)
  createdBy    String
  createdAt    DateTime @default(now())

  steps           EmailSequenceStep[]
  enrollments     EmailSequenceEnrollment[]
  EmailEngagement EmailEngagement[]

  @@index([active])
}

model EmailSequenceStep {
  id         String        @id @default(cuid())
  sequenceId String
  sequence   EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  stepOrder  Int
  delayDays  Int // days after the PREVIOUS step (0 for the first step — sent on enrollment)
  subject    String
  subjectB   String? // optional A/B variant
  body       String        @db.Text
  bodyB      String? // optional A/B variant

  engagement EmailEngagement[]

  @@unique([sequenceId, stepOrder])
}

model EmailSequenceEnrollment {
  id          String        @id @default(cuid())
  sequenceId  String
  sequence    EmailSequence @relation(fields: [sequenceId], references: [id], onDelete: Cascade)
  userId      String
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStep Int           @default(0)
  status      String        @default("active") // "active" | "completed" | "stopped" | "exited_by_rule"
  // Assigned once at enrollment (see lib/emailSequences.ts) — 50/50 only when
  // the sequence has any step with a B variant defined, otherwise always "A"
  // so a sequence with no A/B content never wastes a random draw on it.
  variant     String        @default("A") // "A" | "B"
  enrolledAt  DateTime      @default(now())
  nextSendAt  DateTime
  lastSentAt  DateTime?

  @@unique([sequenceId, userId])
  @@index([status, nextSendAt])
}

// One row per tracked lifecycle event for one send — a step send, a step
// open/click (via the Resend webhook), or a one-off Broadcast send. Exactly
// one of sequenceId/stepId or broadcastId is meaningfully set per row in
// practice, but the model itself doesn't enforce that (SQLite/Postgres has
// no clean "exactly one of" constraint) — callers only ever populate the
// pair that applies. broadcastId is a plain opaque string, not a relation:
// one-off broadcasts aren't persisted as their own DB rows (they're a
// Resend send + an AuditLog entry, or a ScheduledEmail row), so there's
// nothing in this schema for it to reference yet.
model EmailEngagement {
  id            String             @id @default(cuid())
  sequenceId    String?
  sequence      EmailSequence?     @relation(fields: [sequenceId], references: [id], onDelete: SetNull)
  stepId        String?
  step          EmailSequenceStep? @relation(fields: [stepId], references: [id], onDelete: SetNull)
  broadcastId   String? // for one-off broadcasts — see model comment
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event         String // "sent" | "opened" | "clicked" | "bounced"
  // Resend's own message id (CreateEmailResponseSuccess.id), set ONLY on the
  // "sent" row for a given send — not in the original field list, but
  // required to correlate an incoming Resend webhook event back to a
  // sequence/step/user: the webhook payload identifies the email only by
  // this id (BaseEmailEventData.email_id), never by our own ids. See
  // app/api/webhooks/resend, which looks up the "sent" row by this field to
  // learn which sequence/step/user an "opened"/"clicked"/"bounced" event
  // belongs to, then writes a new row with the same sequenceId/stepId/userId.
  resendEmailId String?            @unique
  createdAt     DateTime           @default(now())

  @@index([sequenceId])
  @@index([stepId])
  @@index([userId])
}
